{
  "name": "seros-app",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "build:vercel": "npm run build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed.ts",
    "auth": "tsx src/auth-cli.ts",
    "set-password": "tsx src/auth-cli.ts set-password",
    "invite": "tsx src/auth-cli.ts invite",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/detection.ts",
    "check:tenancy": "tsx tools/check-tenancy.ts",
    "test": "SEROS_PROVIDER=fake SEROS_TRACKER=fake tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run check:tenancy && npm test"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17"
  },
  "engines": {
    "node": ">=18"
  }
}
